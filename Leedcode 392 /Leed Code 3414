class Solution {
    struct Node {
        long long score = 0;
        vector<int> ids;
    };

    bool better(const Node& a, const Node& b) {
        if (a.score != b.score)
            return a.score > b.score;

        return a.ids < b.ids;
    }

public:
    vector<int> maximumWeight(vector<vector<int>>& intervals) {

        int n = intervals.size();

        // {left, right, weight, original_index}
        vector<array<int, 4>> a;

        for (int i = 0; i < n; i++) {
            a.push_back({
                intervals[i][0],
                intervals[i][1],
                intervals[i][2],
                i
            });
        }

        // Sort by starting point
        sort(a.begin(), a.end());

        vector<vector<Node>> dp(n + 1, vector<Node>(5));

        for (int i = n - 1; i >= 0; i--) {

            int l = a[i][0];
            int r = a[i][1];
            int w = a[i][2];
            int idx = a[i][3];

            // First interval whose start > r
            int lo = i + 1;
            int hi = n;

            while (lo < hi) {
                int mid = lo + (hi - lo) / 2;

                if (a[mid][0] > r)
                    hi = mid;
                else
                    lo = mid + 1;
            }

            int next = lo;

            for (int k = 1; k <= 4; k++) {

                // Option 1: skip current interval
                Node skip = dp[i + 1][k];

                // Option 2: take current interval
                Node take = dp[next][k - 1];

                take.score += w;
                take.ids.push_back(idx);

                sort(take.ids.begin(), take.ids.end());

                if (better(take, skip))
                    dp[i][k] = take;
                else
                    dp[i][k] = skip;
            }
        }

        return dp[0][4].ids;
    }
};
