class Solution {
public:
    bool closeStrings(string word1, string word2) {
        int str1[26] = {0};
        int str2[26] = {0};
    if(word1.length() != word2.length()){
        return false;
    }

    for(int i=0; i<word1.length(); i++){
        str1[word1[i] - 'a']++;
        str2[word2[i] - 'a']++;
    }
    for(int i = 0; i < 26; i++) {
            if((str1[i] == 0) != (str2[i] == 0)) {
                return false;
            }
        }
    sort(str1,str1+26);
    sort(str2,str2+26);

    for(int i=0; i<26; i++){
        if(str1[i] != str2[i]){
            return false;
        }
    }
    return true;


}
    
};
