class Solution {
public:
    int largestOverlap(vector<vector<int>>& img1, vector<vector<int>>& img2) {
        int n = img1.size();
        vector<pair<int, int>> p1, p2;
        
        // Collect coordinates of all 1s in both images
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                if (img1[i][j] == 1) p1.push_back({i, j});
                if (img2[i][j] == 1) p2.push_back({i, j});
            }
        }
        
        map<pair<int, int>, int> shiftCount;
        int maxOverlap = 0;
        
        // Calculate the translation vector for every pair of 1s
        for (auto& a : p1) {
            for (auto& b : p2) {
                int dr = b.first - a.first;
                int dc = b.second - a.second;
                shiftCount[{dr, dc}]++;
                maxOverlap = max(maxOverlap, shiftCount[{dr, dc}]);
            }
        }
        
        return maxOverlap;
    }
};
